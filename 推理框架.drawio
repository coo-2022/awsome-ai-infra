          <mxGeometry height="60" width="120" x="470" y="2750" as="geometry" />
        </mxCell>
        <mxCell id="mj0aG5FPjsjfJJtwL3H--13" edge="1" parent="1" source="mj0aG5FPjsjfJJtwL3H--7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="mj0aG5FPjsjfJJtwL3H--10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mj0aG5FPjsjfJJtwL3H--7" parent="1" style="whiteSpace=wrap;html=1;" value="未命中" vertex="1">
          <mxGeometry height="60" width="120" x="710" y="2810" as="geometry" />
        </mxCell>
        <mxCell id="mj0aG5FPjsjfJJtwL3H--9" parent="1" style="whiteSpace=wrap;html=1;" value="已命中" vertex="1">
          <mxGeometry height="60" width="120" x="710" y="2690" as="geometry" />
        </mxCell>
        <mxCell id="mj0aG5FPjsjfJJtwL3H--15" edge="1" parent="1" source="mj0aG5FPjsjfJJtwL3H--10" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="mj0aG5FPjsjfJJtwL3H--14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mj0aG5FPjsjfJJtwL3H--10" parent="1" style="whiteSpace=wrap;html=1;" value="SSD读取" vertex="1">
          <mxGeometry height="60" width="120" x="910" y="2810" as="geometry" />
        </mxCell>
        <mxCell id="mj0aG5FPjsjfJJtwL3H--14" parent="1" style="shape=ext;margin=3;double=1;whiteSpace=wrap;html=1;align=center;" value="device buffer" vertex="1">
          <mxGeometry height="40" width="100" x="1070" y="2700" as="geometry" />
        </mxCell>
        <mxCell id="mj0aG5FPjsjfJJtwL3H--16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;rotation=-60;" value="拷贝" vertex="1">
          <mxGeometry height="30" width="60" x="1060" y="2780" as="geometry" />
        </mxCell>
        <mxCell id="RBh_48pG49wutGlAYt---1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;启动命令&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;全部命令如下。这次不用 msprof 包装，直接启 server，用 HTTP 接口控制 profiling：&lt;/div&gt;&lt;div&gt;# ========== 第 1 步：进容器 ==========&lt;/div&gt;&lt;div&gt;ssh root@141.111.98.182&lt;/div&gt;&lt;div&gt;docker exec -it sglang-perf-debug bash&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# ========== 第 2 步：环境 + 启动 server（不用 msprof） ==========&lt;/div&gt;&lt;div&gt;source /usr/local/Ascend/cann-9.0.0/set_env.sh&lt;/div&gt;&lt;div&gt;source /usr/local/Ascend/ascend-toolkit/set_env.sh&lt;/div&gt;&lt;div&gt;source /usr/local/Ascend/nnal/atb/set_env.sh&lt;/div&gt;&lt;div&gt;source /usr/local/Ascend/cann-9.0.0/opp/vendors/customize/bin/set_env.bash&lt;/div&gt;&lt;div&gt;source /usr/local/Ascend/cann-9.0.0/opp/vendors/custom_transformer/bin/set_env.bash&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;VA_OPP=/mnt/models/models/src/vllm-ascend/vllm_ascend/_cann_ops_custom/vendors/custom_transformer&lt;/div&gt;&lt;div&gt;DEEP_EP_PATH=/usr/local/python3.11.15/lib/python3.11/site-packages/deep_ep/vendors/hwcomputing&lt;/div&gt;&lt;div&gt;export LD_LIBRARY_PATH=${VA_OPP}/op_api/lib:${DEEP_EP_PATH}/op_api/lib:${LD_LIBRARY_PATH}&lt;/div&gt;&lt;div&gt;export ASCEND_CUSTOM_OPP_PATH=${VA_OPP}:${DEEP_EP_PATH}:${ASCEND_CUSTOM_OPP_PATH}&lt;/div&gt;&lt;div&gt;export LD_PRELOAD=/usr/local/Ascend/cann-9.0.0/aarch64-linux/lib64/libnnopbase.so:${LD_PRELOAD}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;export HCCL_OP_EXPANSION_MODE=AIV&lt;/div&gt;&lt;div&gt;export HCCL_BUFFSIZE=128&lt;/div&gt;&lt;div&gt;export TASK_QUEUE_ENABLE=1&lt;/div&gt;&lt;div&gt;export OMP_NUM_THREADS=10&lt;/div&gt;&lt;div&gt;export PYTORCH_NPU_ALLOC_CONF=expandable_segments:True&lt;/div&gt;&lt;div&gt;export HCCL_CONNECT_TIMEOUT=7200&lt;/div&gt;&lt;div&gt;export HCCL_EXEC_TIMEOUT=7200&lt;/div&gt;&lt;div&gt;export HCCL_TRANSFER_TIMEOUT=7200&lt;/div&gt;&lt;div&gt;export SGLANG_OPT_FP8_WO_A_GEMM=0&lt;/div&gt;&lt;div&gt;export SGLANG_OPT_FUSE_WQA_WKV=0&lt;/div&gt;&lt;div&gt;export SGLANG_OPT_USE_FUSED_HASH_TOPK=0&lt;/div&gt;&lt;div&gt;export SGLANG_HISPARSE_OFFLOAD=dram&lt;/div&gt;&lt;div&gt;export HISPARSE_MISS_STATS=1&lt;/div&gt;&lt;div&gt;# 关闭 record_cycle profiler（这次不用它）&lt;/div&gt;&lt;div&gt;export SGLANG_HISPARSE_PROF=0&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 启动 server（后台）&lt;/div&gt;&lt;div&gt;cd /root/sglang-perf&lt;/div&gt;&lt;div&gt;python3 -m sglang.launch_server \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --model-path /mnt/models/models/DeepSeek-V4-Flash-0731-w8a8 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --tp 8 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --trust-remote-code \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --enable-hisparse \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --disable-radix-cache \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --quantization modelslim \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --context-length 262144 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --mem-fraction-static 0.75 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --max-running-requests 1 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --host 0.0.0.0 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --port 30000 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --log-level info \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --hisparse-config &#39;{&quot;device_buffer_size&quot;:2048,&quot;host_to_device_ratio&quot;:2}&#39; \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --chunked-prefill-size 8192 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --max-prefill-tokens 65536 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --cuda-graph-config &#39;{&quot;decode&quot;:{&quot;bs&quot;:[1]}}&#39; \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --time-pd-disagg \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --skip-server-warmup \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; --watchdog-timeout 7200 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;gt; /tmp/server.log 2&amp;gt;&amp;amp;1 &amp;amp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 等 server 就绪&lt;/div&gt;&lt;div&gt;echo &quot;Waiting for server...&quot;&lt;/div&gt;&lt;div&gt;for i in $(seq 1 600); do&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; curl -s -o /dev/null -w &quot;%{http_code}&quot; http://localhost:30000/health 2&amp;gt;/dev/null | grep -q &quot;200&quot; &amp;amp;&amp;amp; { echo &quot;Server ready!&quot;; break; }&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; sleep 1&lt;/div&gt;&lt;div&gt;done&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# ========== 第 3 步：发 benchmark 请求（后台） ==========&lt;/div&gt;&lt;div&gt;# 254K token prompt + 2048 output，大约 prefill 110s + decode 96s&lt;/div&gt;&lt;div&gt;python3 /tmp/bench_182_text.py &amp;gt; /tmp/bench.log 2&amp;gt;&amp;amp;1 &amp;amp;&lt;/div&gt;&lt;div&gt;BENCH_PID=$!&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# ========== 第 4 步：等 prefill 结束后发 start_profile ==========&lt;/div&gt;&lt;div&gt;# prefill 约 110s，等 120s 确保进入 decode&lt;/div&gt;&lt;div&gt;echo &quot;Waiting 120s for prefill to finish...&quot;&lt;/div&gt;&lt;div&gt;sleep 120&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 开始 profiling（采集 200 步 decode）&lt;/div&gt;&lt;div&gt;echo &quot;[$(date)] Starting profile...&quot;&lt;/div&gt;&lt;div&gt;curl -s -X POST http://localhost:30000/start_profile \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; -H &quot;Content-Type: application/json&quot; \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; -d &#39;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;activities&quot;: [&quot;CPU&quot;, &quot;NPU&quot;],&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;num_steps&quot;: 200,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;output_dir&quot;: &quot;/root/sglang-perf/torch_prof&quot;,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;with_stack&quot;: true,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;profile_id&quot;: &quot;decode_test&quot;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; }&#39;&lt;/div&gt;&lt;div&gt;echo &quot;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# ========== 第 5 步：等 benchmark 完成 ==========&lt;/div&gt;&lt;div&gt;wait $BENCH_PID&lt;/div&gt;&lt;div&gt;echo &quot;[$(date)] Benchmark done:&quot;&lt;/div&gt;&lt;div&gt;cat /tmp/bench.log&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# ========== 第 6 步：停 profiling（如果 num_steps 到了会自动停，这里兜底） ==========&lt;/div&gt;&lt;div&gt;curl -s -X POST http://localhost:30000/stop_profile&lt;/div&gt;&lt;div&gt;echo &quot;&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# ========== 第 7 步：看结果 ==========&lt;/div&gt;&lt;div&gt;echo &quot;=== Profile output ===&quot;&lt;/div&gt;&lt;div&gt;ls -lh /root/sglang-perf/torch_prof/&lt;/div&gt;&lt;div&gt;echo &quot;=== Server log tail ===&quot;&lt;/div&gt;&lt;div&gt;tail -20 /tmp/server.log&lt;/div&gt;" vertex="1">
          <mxGeometry height="1560" width="600" x="40" y="3110" as="geometry" />
        </mxCell>
        <mxCell id="58YOFUNCJcAP2g3_kidV-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;font style=&quot;font-size: 18px; color: light-dark(rgb(0, 0, 0), rgb(255, 0, 0));&quot;&gt;SSD offload的命令&lt;/font&gt;&lt;/div&gt;&lt;div&gt;1. 重编 + 加载 NDS 驱动（重启后必做）&lt;/div&gt;&lt;div&gt;# 重编（kASLR 地址随重启变化）&lt;/div&gt;&lt;div&gt;cd /home/l00938527/NPU_Direct_Storage/src/host/bam_nvme/module&lt;/div&gt;&lt;div&gt;make clean &amp;amp;&amp;amp; make CANN=1&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 加载驱动&lt;/div&gt;&lt;div&gt;insmod libnvm_helper.ko&lt;/div&gt;&lt;div&gt;lsmod | grep nvm_helper&lt;/div&gt;&lt;div&gt;grep libnvm /proc/devices&amp;nbsp; &amp;nbsp;# 记下主设备号，如 507&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 拆 raid + 切驱动（如果 nvme1 还在 nvme 驱动下）&lt;/div&gt;&lt;div&gt;mdadm --stop /dev/md126&lt;/div&gt;&lt;div&gt;echo 0000:84:00.0 &amp;gt; /sys/bus/pci/drivers/nvme/unbind&lt;/div&gt;&lt;div&gt;echo 0000:84:00.0 &amp;gt; &quot;/sys/bus/pci/drivers/libnvm helper/bind&quot;&lt;/div&gt;&lt;div&gt;dmesg | tail -5&amp;nbsp; &amp;nbsp;# 确认 &quot;Character device /dev/libnvm_helper0 created&quot;&lt;/div&gt;&lt;div&gt;2. 启动 NDS server + agent（宿主机上跑）&lt;/div&gt;&lt;div&gt;export LD_LIBRARY_PATH=/home/l00938527/Ascend/cann-9.0.0/aarch64-linux/lib64:/home/l00938527/Ascend/cann-9.0.0/aarch64-linux/lib64/plugin/opskernel:/home/l00938527/Ascend/cann-9.0.0/opp/built-in/op_impl/ai_core/tbe/op_tiling:/home/l00938527/Ascend/driver/lib64&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 清残留&lt;/div&gt;&lt;div&gt;pkill -9 -f nds_server; pkill -9 -f nds_agent; sleep 1&lt;/div&gt;&lt;div&gt;rm -f /home/l00938527/nds/*.sock&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 起 server&lt;/div&gt;&lt;div&gt;nohup /home/l00938527/NDS-ssd/nds_multicliet/nds_server \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --ctrl /dev/libnvm_helper0 --ns 1 --qd 64 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --socket /home/l00938527/nds/nvm_host_rpc.sock \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;gt; /home/l00938527/nds/nds_server.log 2&amp;gt;&amp;amp;1 &amp;amp;&lt;/div&gt;&lt;div&gt;sleep 2&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 起 agent&lt;/div&gt;&lt;div&gt;nohup env \&lt;/div&gt;&lt;div&gt;&amp;nbsp; NDS_RPC_SOCKET=/home/l00938527/nds/nvm_host_rpc.sock \&lt;/div&gt;&lt;div&gt;&amp;nbsp; NDS_AGENT_SOCKET=/home/l00938527/nds/nds_agent.sock \&lt;/div&gt;&lt;div&gt;&amp;nbsp; NDS_LIBNVM_HOST=/home/l00938527/NPU_Direct_Storage/build/lib/libnvm_host.so \&lt;/div&gt;&lt;div&gt;&amp;nbsp; LD_LIBRARY_PATH=$LD_LIBRARY_PATH \&lt;/div&gt;&lt;div&gt;&amp;nbsp; python3 /home/l00938527/NDS-ssd/nds_multicliet/nds_agent.py \&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;gt; /home/l00938527/nds/nds_agent.log 2&amp;gt;&amp;amp;1 &amp;amp;&lt;/div&gt;&lt;div&gt;sleep 2&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 验证&lt;/div&gt;&lt;div&gt;ps aux | grep -E &quot;nds_server|nds_agent&quot; | grep -v grep&lt;/div&gt;&lt;div&gt;ls -la /home/l00938527/nds/*.sock&lt;/div&gt;&lt;div&gt;# agent log 应有: &quot;代理就绪: /home/l00938527/nds/nds_agent.sock&quot;&lt;/div&gt;&lt;div&gt;3. 重建容器（已做，跳过则忽略）&lt;/div&gt;&lt;div&gt;docker stop sglang-perf-debug &amp;amp;&amp;amp; docker rm sglang-perf-debug&lt;/div&gt;&lt;div&gt;docker run -d \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --name sglang-perf-debug \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --runtime ascend \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --privileged \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --network host \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --ipc shareable \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --device /dev/davinci_manager \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --device /dev/devmm_svm \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --device /dev/hisi_hdc \&lt;/div&gt;&lt;div&gt;&amp;nbsp; --device /dev/libnvm_helper0 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; -v /mnt/models/models:/mnt/models/models \&lt;/div&gt;&lt;div&gt;&amp;nbsp; -v /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro \&lt;/div&gt;&lt;div&gt;&amp;nbsp; -v /usr/local/dcmi:/usr/local/dcmi:ro \&lt;/div&gt;&lt;div&gt;&amp;nbsp; -v /etc/ascend_install.info:/etc/ascend_install.info:ro \&lt;/div&gt;&lt;div&gt;&amp;nbsp; -v /home/l00938527:/home/l00938527 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; -e ASCEND_VISIBLE_DEVICES=0,1,2,3,4,5,6,7 \&lt;/div&gt;&lt;div&gt;&amp;nbsp; sglang-hisparse:exported \&lt;/div&gt;&lt;div&gt;&amp;nbsp; /bin/bash -c &#39;sleep infinity&#39;&lt;/div&gt;&lt;div&gt;4. 容器内同步代码 + SSD .so&lt;/div&gt;&lt;div&gt;# 从 SGLang-ssd 拷贝编译好的 SSD .so&lt;/div&gt;&lt;div&gt;docker cp /home/l00938527/SGLang-ssd/python/sglang/srt/hardware_backend/npu/op_impl/hisparse/hisparse_lru.so \&lt;/div&gt;&lt;div&gt;&amp;nbsp; sglang-perf-debug:/sgl-workspace/sglang/python/sglang/srt/hardware_backend/npu/op_impl/hisparse/hisparse_lru.so&lt;/div&gt;&lt;div&gt;docker cp /home/l00938527/SGLang-ssd/python/sglang/srt/hardware_backend/npu/op_impl/hisparse/hisparse_lru.cpython-311-aarch64-linux-gnu.so \&lt;/div&gt;&lt;div&gt;&amp;nbsp; sglang-perf-debug:/sgl-workspace/sglang/python/sglang/srt/hardware_backend/npu/op_impl/hisparse/hisparse_lru.cpython-311-aarch64-linux-gnu.so&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 从本地同步 Python 源码（我之前已 scp 到 /home/l00938527/hisparse_ssd_sync/）&lt;/div&gt;&lt;div&gt;S=/home/l00938527/hisparse_ssd_sync&lt;/div&gt;&lt;div&gt;D=/sgl-workspace/sglang/python/sglang/srt&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/hisparse_coordinator.py $D/managers/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/profiler_manager.py $D/managers/scheduler_components/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/hisparse_ssd_pool.py $D/mem_cache/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/state_offload_backend.py $D/managers/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/hisparse_pd_state.py $D/managers/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/req_time_stats.py $D/observability/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/http_server.py $D/entrypoints/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/deepseek_v4.py $D/models/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug mkdir -p $D/perf_analysis&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/cycle_profiler.py $D/perf_analysis/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/step_profiler.py $D/perf_analysis/&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug cp $S/__init__.py $D/hardware_backend/npu/op_impl/hisparse/&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 验证 SSD 符号&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug nm -D $D/hardware_backend/npu/op_impl/hisparse/hisparse_lru.so | grep scatter_from_ssd&lt;/div&gt;&lt;div&gt;# 应有 4+ 行输出&lt;/div&gt;&lt;div&gt;5. 启动 SGLang SSD server&lt;/div&gt;&lt;div&gt;cat &amp;gt; /tmp/start_sgl.sh &amp;lt;&amp;lt; &#39;EOF&#39;&lt;/div&gt;&lt;div&gt;#!/bin/bash&lt;/div&gt;&lt;div&gt;export SGLANG_HISPARSE_OFFLOAD=ssd&lt;/div&gt;&lt;div&gt;export SGLANG_HISPARSE_SSD_SELFTEST=0&lt;/div&gt;&lt;div&gt;export SGLANG_NDS_CAPI_LIB=/home/l00938527/NDS-ssd/nds_multicliet/libnds_capi.so&lt;/div&gt;&lt;div&gt;export NDS_AGENT_SOCKET=/home/l00938527/nds/nds_agent.sock&lt;/div&gt;&lt;div&gt;export SGLANG_NDS_RPC_SOCKET=&lt;/div&gt;&lt;div&gt;export SGLANG_NDS_PRELOAD=/home/l00938527/NPU_Direct_Storage/build/lib/libnvm_host.so:/home/l00938527/NPU_Direct_Storage/build/lib/libread-write_kernel.so:/home/l00938527/NPU_Direct_Storage/build/lib/libnds_aiv.so&lt;/div&gt;&lt;div&gt;export SGLANG_NDS_SSD_BASE=0x40000000&lt;/div&gt;&lt;div&gt;export SGLANG_HISPARSE_SSD_READ_PAGES=8192&lt;/div&gt;&lt;div&gt;export SGLANG_HISPARSE_SSD_WRITE_PAGES=8192&lt;/div&gt;&lt;div&gt;export SGLANG_OPT_FP8_WO_A_GEMM=0&lt;/div&gt;&lt;div&gt;export SGLANG_OPT_FUSE_WQA_WKV=0&lt;/div&gt;&lt;div&gt;export SGLANG_OPT_USE_FUSED_HASH_TOPK=0&lt;/div&gt;&lt;div&gt;cd /sgl-workspace/sglang&lt;/div&gt;&lt;div&gt;exec python3 /home/l00938527/sglang-perf/server_ssd.py&lt;/div&gt;&lt;div&gt;EOF&lt;/div&gt;&lt;div&gt;chmod +x /tmp/start_sgl.sh&lt;/div&gt;&lt;div&gt;docker cp /tmp/start_sgl.sh sglang-perf-debug:/tmp/start_sgl.sh&lt;/div&gt;&lt;div&gt;docker exec -d sglang-perf-debug bash -c &quot;bash /tmp/start_sgl.sh &amp;gt; /home/l00938527/sglang-perf/server_ssd.log 2&amp;gt;&amp;amp;1&quot;&lt;/div&gt;&lt;div&gt;6. 监控&lt;/div&gt;&lt;div&gt;# 看日志（模型加载 ~2min，SSD 初始化 ~30s）&lt;/div&gt;&lt;div&gt;tail -f /home/l00938527/sglang-perf/server_ssd.log&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 关键成功标志&lt;/div&gt;&lt;div&gt;grep -E &quot;SSDDBG|init ok|CREATE_QPAIR|dma_map|fired up|Uvicorn&quot; /home/l00938527/sglang-perf/server_ssd.log&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# 健康检查&lt;/div&gt;&lt;div&gt;docker exec sglang-perf-debug curl -s http://localhost:30000/health&lt;/div&gt;&lt;div&gt;注意：SGLANG_HISPARSE_SSD_SELFTEST=0 是跳过 NPU 环回自检（当前 NPU 报 507057 错误）。如果后续 SSD 读写有问题再打开排查。&lt;/div&gt;" vertex="1">
          <mxGeometry height="1830" width="795" x="660" y="3130" as="geometry" />
        </mxCell>
        <mxCell id="1Ud2rF5iZjg1NJvDUJv8-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;" value="入口：forward_c4_indexer_npu&lt;div&gt;输入：query + C4 kv cache&lt;/div&gt;&lt;div&gt;输出：topk_index[bs, top_k]&lt;/div&gt;&lt;div&gt;流程：在kernel上执行topk&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="170" x="445" y="2880" as="geometry" />
        </mxCell>
        <mxCell id="1Ud2rF5iZjg1NJvDUJv8-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=10;" value="入口：hisparse_lru_update&lt;div&gt;输入：topk_indices、device buffer&lt;/div&gt;&lt;div&gt;输出：topk_k_device_slots、is_miss&lt;/div&gt;&lt;div&gt;流程：在kernel上执行topk，&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="170" x="685" y="2900" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
